# ----------------------------------------------------------------------------
# PUBLIC — safe to expose in the browser (Supabase publishable key)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# ----------------------------------------------------------------------------
# SERVER ONLY — never prefixed with NEXT_PUBLIC_
# ----------------------------------------------------------------------------
# The only email address allowed into the admin dashboard.
OWNER_EMAIL=aswinav277@gmail.com

# Resend — powers the contact form email delivery.
# Create a free key at https://resend.com/api-keys (never commit it).
RESEND_API_KEY=
# Must be a verified Resend sender. onboarding@resend.dev only delivers to the
# Resend account owner, which is fine for a personal portfolio.
CONTACT_FROM_EMAIL=ASWIN A V Portfolio <onboarding@resend.dev>
# Where enquiries are delivered.
CONTACT_TO_EMAIL=aswinav277@gmail.com

# Optional: public site URL used in emails / metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
